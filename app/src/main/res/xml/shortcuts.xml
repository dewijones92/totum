<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_alarm"
        android:enabled="true"
        android:icon="@drawable/ic_dailyalarm"
        android:shortcutShortLabel="@string/oneoff_new"
        android:shortcutLongLabel="@string/oneoff_new_long">
        <intent
            android:action="com.dewijones92.totum.NEW_ALARM"
            android:targetPackage="com.dewijones92.totum"
            android:targetClass="com.dewijones92.totum.dailyalarms.DailyAlarmsActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="ask"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/ask_shortcut_short"
        android:shortcutLongLabel="@string/ask_shortcut_long">
        <intent
            android:action="com.dewijones92.totum.ASK"
            android:targetPackage="com.dewijones92.totum"
            android:targetClass="com.dewijones92.totum.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="send_report"
        android:enabled="true"
        android:icon="@drawable/ic_bug_report"
        android:shortcutShortLabel="@string/send_report_shortcut_short"
        android:shortcutLongLabel="@string/send_report_shortcut_long">
        <intent
            android:action="com.dewijones92.totum.SEND_REPORT"
            android:targetPackage="com.dewijones92.totum"
            android:targetClass="com.dewijones92.totum.diagnostics.SendReportActivity" />
    </shortcut>
</shortcuts>
