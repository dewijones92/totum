<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="phone_use_name">📱 Phone use</string>
    <string name="phone_use_intro">Totum counts how often you unlock your phone and how long the screen is on, from the history Android already keeps, so nothing has to run all day. You can also ask it to stop you for a moment when you unlock again soon after the last time.</string>
    <string name="phone_use_channel">Phone use nudge</string>

    <string name="phone_use_access_title">Usage access</string>
    <string name="phone_use_access_on">✅ Usage access is on</string>
    <string name="phone_use_access_off">⚠️ Usage access is off</string>
    <string name="phone_use_access_why">Android only lets an app read when the screen came on, when the phone was unlocked and which app opened first once you allow this, once. Totum keeps only those times and app names on this phone; it does not read what is in any app.</string>
    <string name="phone_use_access_open">Open usage access</string>
    <string name="phone_use_access_restricted">ℹ️ If Android greys the switch out: Settings → Apps → Totum → ⋮ → Allow restricted settings, then try again.</string>

    <string name="phone_use_nudge_card">Unlock nudge</string>
    <string name="phone_use_nudge_on">🟢 The nudge is on</string>
    <string name="phone_use_nudge_off">⚪ The nudge is off</string>
    <string name="phone_use_nudge_switch">Nudge me when I unlock again soon</string>
    <string name="phone_use_nudge_switch_summary">A full-screen \"still want in?\" that you can wave through after five seconds</string>
    <string name="phone_use_nudge_within">Nudge me if I unlock within this long of the last unlock</string>
    <plurals name="phone_use_nudge_minutes">
        <item quantity="one">⏳ %d min</item>
        <item quantity="other">⏳ %d min</item>
    </plurals>
    <string name="phone_use_nudge_needs_access">⚠️ The nudge needs usage access to see your earlier unlocks. Until it is on, nothing is shown.</string>
    <string name="phone_use_nudge_honest">ℹ️ Totum cannot lock your phone: Android does not let an app do that. The nudge is a screen that asks, and it never stops you. Back and Home always work, and it stays out of calls, the camera, navigation, Exsurge, alarms, the kid lock and a video playing in Totum.</string>

    <string name="phone_use_nudge_title">⏳ Still want in?</string>
    <string name="phone_use_nudge_line">⏳ You unlocked %1$s (%2$d today). Still want in?</string>
    <string name="phone_use_ago_under_a_minute">less than a minute ago</string>
