    <!-- Queue offline readiness. Wording is deliberately plain: these answer "can I listen to
         this with no signal?" at a glance, which a per-row glyph never could. Plurals rather
         than "item(s)", because the whole point of this line is that it reads like a sentence. -->
    <plurals name="queue_offline_ready_all">
        <item quantity="one">Ready to play offline</item>
        <item quantity="other">All %1$d ready to play offline</item>
    </plurals>
    <!-- Shown when the queue holds something the automatic downloads will never fetch — a film,
         whose only audio-only form is a live stream that cannot be stored. Downloading it by hand
         works, which is why this is not the "can't be downloaded" line. -->
    <plurals name="queue_offline_manual_only">
        <item quantity="one">%1$d ready offline · 1 to download by hand</item>
        <item quantity="other">%1$d ready offline · %2$d to download by hand</item>
    </plurals>
    <plurals name="queue_offline_ready_with_gaps">
        <item quantity="one">%1$d ready offline · 1 can\'t be downloaded</item>
        <item quantity="other">%1$d ready offline · %2$d can\'t be downloaded</item>
    </plurals>
    <!-- Shown on a queue row that cannot play because it is not on the device and there is no
         network. The queue skips these rather than stalling on each; without the label a skipped
         item reads as the app losing your place. -->
    <!-- Shown when the phone drops off Wi-Fi mid-video and the app switches to audio to protect
         mobile data. Measured saving: 15.2 MB/min against 2.1. -->
    <string name="data_saver_channel_name">Data saving</string>
