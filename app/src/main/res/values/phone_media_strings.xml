    <string name="phone_ask_title">🔓 Let Totum see the media on this phone</string>
    <string name="phone_ask_body">Totum reads the videos, music and photos stored on this phone so they play with its queue, speed, silence skipping, resume and casting. They are read in place and never copied or sent anywhere.</string>
    <string name="phone_ask_button">🔓 Allow access</string>
    <string name="phone_blocked_title">🔒 Totum can\'t see %1$s on this phone</string>
    <string name="phone_blocked_body">Android only lets you change this in Settings: open Totum\'s permissions there and allow Photos and videos and Music and audio.</string>
    <string name="phone_blocked_button">⚙️ Open Settings</string>
