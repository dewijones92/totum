<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Downloads keep the process alive the same way playback does; without this a backgrounded
         app is a cached process Android reclaims mid-download. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TotumApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Totum">
        <profileable android:shell="true" />
        <service
            android:name=".downloads.DownloadKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".recorder.RecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone|camera" />
        <service
            android:name=".recorder.RecorderTileService"
            android:exported="true"
            android:icon="@drawable/ic_recorder"
            android:label="@string/recorder_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".recorder.RecorderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.dewijones92.totum.recorder.screen"
            android:label="@string/recorder_shortcut_long"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".exsurge.ExsurgeBannerService"
            android:exported="false"
            android:foregroundServiceType="health" />
        <service
            android:name=".exsurge.ExsurgeTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/exsurge_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver
            android:name=".jobs.QueueTidyUndoReceiver"
            android:exported="false" />
        <receiver
            android:name=".exsurge.ExsurgeActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".exsurge.ExsurgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.dewijones92.totum.exsurge.screen"
            android:label="@string/exsurge_name"
            android:theme="@style/Theme.Totum">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <activity
            android:name=".exsurge.TakeoverActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.dewijones92.totum.exsurge"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Totum" />
        <service
            android:name=".dailyalarms.RingService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />
        <service
            android:name=".dailyalarms.AlarmBoardService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />
        <service
            android:name=".dailyalarms.NewAlarmTileService"
            android:exported="true"
            android:icon="@drawable/ic_dailyalarm"
            android:label="@string/oneoff_new"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".dailyalarms.DailyAlarmTileService"
            android:exported="true"
            android:icon="@drawable/ic_dailyalarm"
            android:label="@string/dailyalarm_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver
            android:name=".dailyalarms.DailyAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".dailyalarms.DailyAlarmsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.dewijones92.totum.dailyalarms.screen"
            android:label="@string/alarms_tile"
            android:theme="@style/Theme.Totum" />
        <service
            android:name=".workapps.WorkAppsListenerService"
            android:exported="true"
            android:label="@string/work_apps_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name=".workapps.WorkAppsQuietActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.dewijones92.totum.workapps.screen"
            android:label="@string/work_apps_name"
            android:theme="@style/Theme.Totum" />
        <activity
            android:name=".bedtime.BedtimeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.dewijones92.totum.bedtime.screen"
            android:label="@string/bedtime_name"
            android:theme="@style/Theme.Totum" />
        <activity
            android:name=".dailyalarms.QuestionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.dewijones92.totum.dailyalarms.question"
            android:showWhenLocked="true"
            android:theme="@style/Theme.Totum" />
        <activity
            android:name=".exsurge.RestartClockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.dewijones92.totum.exsurge.restart"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".dailyalarms.QuickAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.dewijones92.totum.dailyalarms.quick"
            android:showWhenLocked="true"
            android:theme="@style/Theme.Totum" />
        <activity
            android:name=".dailyalarms.RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.dewijones92.totum.dailyalarms.ring"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Totum" />
        <!-- Cast: tells the framework where to find our CastOptions. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.dewijones92.totum.cast.CastOptionsProvider" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        <service
            android:name=".diagnostics.SendReportTileService"
            android:exported="true"
            android:icon="@drawable/ic_bug_report"
            android:label="@string/send_report_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".diagnostics.SendReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.dewijones92.totum.diagnostics.report"
            android:label="@string/send_report_shortcut_long"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".downloads.home.SendHomeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/send_home_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Appear in the share sheet for a plain-text share (a URL from a browser/app). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- How the home server hands this app its access token. The user signs in with
                 Google in a real browser (the only place Google accepts a sign-in), and the page
                 behind that gate redirects to totum://auth?token=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="totum" android:host="auth" />
            </intent-filter>
            <!-- Offered as an option when opening a YouTube link (not an auto-verified
                 app link — we deliberately want the chooser, not to hijack the domain). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>
        </activity>
    </application>

</manifest>
