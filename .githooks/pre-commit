#!/usr/bin/env bash
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
guard="$root/aerarium/tools/privacy-guard.mjs"
[ -f "$guard" ] || exit 0
node "$guard" --staged
code=$?
if [ "$code" -eq 1 ]; then
  echo "pre-commit BLOCKED: personal or financial data must never enter this public repo." >&2
  exit 1
fi
if [ "$code" -ne 0 ]; then
  echo "pre-commit: the privacy guard itself failed (exit $code); committing anyway, run it by hand." >&2
fi
exit 0
